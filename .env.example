# Set this to the final HTTPS origin so Open Graph URLs resolve correctly.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only AI receipt/PDF processing
GEMINI_API_KEY=your-gemini-api-key

# Server-only Web Push notifications
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# Fallback subject email dengan domain valid (dipakai kalau VAPID_SUBJECT tidak valid
# dan user tidak punya email). WAJIB di-set di production — push akan gagal kalau kosong.
VAPID_SUBJECT_EMAIL=mailto:you@yourdomain.com
CRON_SECRET=replace-with-a-long-random-value
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Optional: developer/admin test token untuk endpoint AI (HANYA untuk development).
# Jangan di-set di production. Kalau kosong, bypass dev tidak aktif sama sekali.
# ARSHIF_DEV_ADMIN_TOKEN=generate-random-value-here
# ARSHIF_DEV_ADMIN_EMAIL=dev-admin@localhost

# Optional server-side Telegram integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value

# Optional: only set this if an external origin must call the API.
# CORS_ORIGINS=https://your-domain.example
