# Set this to the final HTTPS origin so Open Graph URLs resolve correctly.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only AI receipt/PDF processing
GEMINI_API_KEY=your-gemini-api-key

# Server-only Web Push notifications
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=replace-with-a-long-random-value

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
NEXT_PUBLIC_TELEGRAM_CHAT_ID=your-telegram-chat-id

# Optional: only set this if an external origin must call the API.
# CORS_ORIGINS=https://your-domain.example
