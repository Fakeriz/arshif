{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "zod": [
        "../../node_modules/zod"
      ],
      "@supabase/supabase-js": [
        "../../node_modules/@supabase/supabase-js"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ]
}
